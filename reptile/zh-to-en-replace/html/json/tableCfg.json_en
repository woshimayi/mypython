    "HGST_WEB_SWITCH": {
        "style": {
            "width": "100%",
            "border": "none"
        },
        "cssClass": {
            "addClass": "lines-no"
        },
        "easyui": {
            "rownumbers": false,
            "iconCls": "icon-table",
            "fitColumns": false,
            "singleSelect": false,
            "toolbar": "#toolbar",
            "fit": false,
            "columns": [
                [
                    {
                        "field": "key",
                        "title": "name",
                        "halign": "center",
                        "align": "left",
                        "width": "30%"
                    },
                    {
                        "field": "value",
                        "title": "value",
                        "halign": "left",
                        "align": "center",
                        "width": "20%",
                        "checkbox": true
                    },
                    {
                        "field": "comments",
                        "title": "Remark",
                        "halign": "center",
                        "align": "left",
                        "width": "50%"
                    }
                ]
            ]
        },
        "keyData": {
            "EnableWebDataLog": {
                "comments": "* Enable printing of WEB data logs in the browser"
            },
            "EnableLogHtmlEle": {
                "comments": "* Enables printing of HTML element data in the browser"
            },
            "DisableCommitData": {
                "comments": "*Do not submit data (for debugging only)"
            },
            "EnableConsolelog": {
                "comments": "* Enable serial port debugging"
            },
            "EnableHttpdDebug": {
                "comments": "* Enable HTTP debugging"
            },
            "EnableSkipAuth": {
                "comments": "Skip user authentication"
            },
            "EnableHttpdHbusData": {
                "comments": "* Print HBUS data"
            },
            "EnableHttpdHbusCmd": {
                "comments": "* Print HBUS command line"
            },
            "EnableDownloadFile": {
                "comments": "Enable downloading files"
            },
            "DisablePing": {
                "comments": "Disable the ping process function"
            },
            "EnableLanSideViewRedis": {
                "comments": "Enable LAN-side viewing of Redis"
            }
        },
        "define": {
            "keyValue": true,
            "checkRow": true
        },
        "customerCheckout": {
            "url": "/debug?getData"
        },
        "customerCheckin": {
            "url": "/debug"
        }
    },
    "HGST_AGENT_IPTV_BIND": {
        "style": {
            "width": "100%",
            "border": "none"
        },
        "cssClass": {
            "addClass": "lines-no"
        },
        "profile": {
            "edit": {
                "editAllRows": true
            }
        },
        "easyui": {
            "rownumbers": false,
            "iconCls": "icon-table",
            "fitColumns": false,
            "singleSelect": true,
            "fit": false,
            "onLoadSuccess": "bindInterfaceLoadSuccess",
            "toolbar": [
                {
                    "text": "refresh",
                    "iconCls": "icon-reload",
                    "handler": "agentIPTVBindUpdate"
                }
            ],
            "columns": [
                [
                    {
                        "field": "interface",
                        "title": "interface",
                        "halign": "center",
                        "align": "left",
                        "width": "20%"
                    },
                    {
                        "field": "mac",
                        "title": "Optical Router MAC",
                        "halign": "center",
                        "align": "left",
                        "width": "30%"
                    },
                    {
                        "field": "bindInterface",
                        "title": "Optical router IPTV port binding",
                        "halign": "center",
                        "align": "left",
                        "width": "40%",
                        "editor": {
                            "type": "combobox",
                            "options": {
                                "valueField": "bindInterface",
                                "textField": "bindInterfaceText",
                                "data": [
                                    {
                                        "bindInterface": "1",
                                        "bindInterfaceText": "LAN1"
                                    },
                                    {
                                        "bindInterface": "2",
                                        "bindInterfaceText": "LAN2"
                                    },
                                    {
                                        "bindInterface": "0",
                                        "bindInterfaceText": "Not Binding"
                                    }
                                ],
                                "panelHeight": "auto",
                                "required": true,
                                "multiple": true
                            }
                        }
                    }
                ]
            ]
        },
        "customerCheckout": {
            "url": "/agentIPTVBind?action=get",
            "preCheckout": "agentIPTVBindCheckout"
        },
        "customerCheckin": {
            "url": "/agentIPTVBind?action=set",
            "checkin": "agentIPTVBindCheckin"
        }
    },
    "HGST_VLAN_BIND": {
        "style": {
            "width": "100%",
            "border": "none"
        },
        "cssClass": {
            "addClass": "lines-no"
        },
        "profile": {
            "combobox": {
                "readonly": true
            },
            "edit": {
                "editAllRows": true
            },
            "getChanges": false
        },
        "easyui": {
            "rownumbers": false,
            "iconCls": "icon-table",
            "fitColumns": false,
            "singleSelect": false,
            "onLoadSuccess": "vlanBindonLoadSuccess",
            "toolbar": [
                {
                    "text": "refresh",
                    "iconCls": "icon-reload",
                    "handler": "vlanbindUpdate"
                }
            ],
            "fit": false,
            "columns": [
                [
                    {
                        "field": "port",
                        "title": "port",
                        "halign": "center",
                        "align": "center",
                        "width": "20%"
                    },
                    {
                        "field": "mode",
                        "title": "Binding Mode",
                        "halign": "center",
                        "align": "left",
                        "width": "30%",
                        "editor": {
                            "type": "combobox",
                            "options": {
                                "valueField": "mode",
                                "textField": "modeText",
                                "data": [
                                    {
                                        "mode": "0",
                                        "modeText": "Port Binding"
                                    },
                                    {
                                        "mode": "1",
                                        "modeText": "VLAN Binding"
                                    }
                                ],
                                "required": true,
                                "panelHeight": "auto"
                            }
                        }
                    },
                    {
                        "field": "vlanBind",
                        "title": "VLAN Binding",
                        "halign": "center",
                        "align": "center",
                        "width": "50%",
                        "editor": {
                            "type": "textbox"
                        }
                    }
                ]
            ]
        },
        "customerCheckout": {
            "hbusGetPath": "hbus://mdm/",
            "msgType": 201,
            "userTagData": 1,
            "checkout": "vlanBindCheckout"
        },
        "customerCheckin": {
            "hbusPostPath": "hbus://mdm/",
            "msgType": 201,
            "userTagData": 2,
            "otherCheckin": "vlanBindCheckin"
        }
    },
